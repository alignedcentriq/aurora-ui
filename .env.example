# ── Root .env — read by docker-compose for ${VAR} interpolation ────────────────
# Copy to `.env` and fill in. This file (.env) is gitignored and ships to the
# server via rsync, so values are never hand-typed on the server.
#
# Compose interpolates these into the nginx build args (VITE_*) and the redis
# password. Without a real `.env`, the frontend builds with an EMPTY MSAL config
# (login is dead) and redis gets an empty password.

# Azure AD (MSAL) — client id and tenant id are NOT secrets.
VITE_MSAL_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_MSAL_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000

# Must EXACTLY match the SPA redirect URI registered in the Azure app.
# Current server: HTTP only (no TLS). Register this URI in Azure → App registrations
# → Authentication → Single-page application.
VITE_MSAL_REDIRECT_URI=http://hackathon.alignedautomation.com/centriq/

# Redis auth — used by both the redis container and the backend's injected REDIS_URL.
REDIS_PASSWORD=change-me-to-a-strong-secret

# ── LLM (Groq) ───────────────────────────────────────────────────────────────
# All 5 model tiers (router/agent/service/general/summarizer) hit Groq's
# OpenAI-compatible API by default — see backend/app/config.py. Get a key at
# https://console.groq.com/keys.
GROQ_API_KEY=
# Per-tier model overrides (defaults already point at sensible Groq models):
# ROUTER_MODEL_NAME=llama-3.1-8b-instant
# AGENT_MODEL_NAME=openai/gpt-oss-120b
# SERVICE_MODEL_NAME=llama-3.3-70b-versatile
# GENERAL_MODEL_NAME=llama-3.1-8b-instant
# SUMMARIZER_MODEL_NAME=llama-3.1-8b-instant
# Groq has no embeddings endpoint — EMBEDDING_BACKEND defaults to "local"
# (in-process fastembed). Only set EMBEDDING_BASE_URL/EMBEDDING_API_KEY if you
# switch EMBEDDING_BACKEND back to "remote" against some other OpenAI-compatible server.

# ── Langfuse (all optional — safe defaults are baked into docker-compose.yml) ───
# Override only to change the seeded keys or the public URL. These interpolate into
# BOTH langfuse-server (headless init + NEXTAUTH_URL) and the backend, so a single
# value keeps them in sync.
#   LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY — project API keys (default pk/sk-lf-centriq-ai*)
#   LANGFUSE_PROJECT_ID — default centriq-ai (used to build "Open in Langfuse" deep links)
#   LANGFUSE_PUBLIC_URL — browser URL Langfuse is served on. Option 2 = its own subdomain,
#     reverse-proxied by nginx (see nginx/*.conf). Must resolve in DNS AND be forwarded by
#     the HOST nginx to :8090. Default: http://langfuse.hackathon.alignedautomation.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PROJECT_ID=
# LANGFUSE_PUBLIC_URL=http://langfuse.hackathon.alignedautomation.com
