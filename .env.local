VITE_MSAL_REDIRECT_URI=http://localhost:3000/centriq/

# ── Langfuse (local) ──────────────────────────────────────────────────────────
# These match the headless-init keys the local Langfuse is seeded with
# (docker-compose.infra.yml). Loaded with override=True, so they win over any stale
# LANGFUSE_* in .env. LANGFUSE_PROJECT_ID lets the "Open in Langfuse" link build deep
# links with no API lookup. Host is the browser-reachable local Langfuse.
LANGFUSE_PUBLIC_KEY=pk-lf-centriq-ai
LANGFUSE_SECRET_KEY=sk-lf-centriq-ai-2026
LANGFUSE_HOST=http://localhost:3003
LANGFUSE_PROJECT_ID=centriq-ai