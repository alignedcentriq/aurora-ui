# ── backend/.env — copy to `.env` and fill in ─────────────────────────────────
# Gitignored; ships to the server via rsync (no hand-typing on the server).
# Loaded by app/config.py. Everything has a safe default EXCEPT the few marked
# REQUIRED below — missing optional creds only DISABLE features, they don't crash.

# ════════════════ REQUIRED for the app to actually function ════════════════
# Hosted Postgres + pgvector. The DB must allow `CREATE EXTENSION vector`.
# GOTCHA: from inside the container, 127.0.0.1 is the container, NOT the host.
# If the DB is on the same box, use the host LAN IP, or set the backend service's
# extra_hosts: ["host.docker.internal:host-gateway"] and use host.docker.internal.
DATABASE_URL=postgresql://user:password@db-host:5432/centriq

# Public origin of the deployment. Feeds approval-email links (/api/approve/...),
# document download URLs, the public verify QR (/verify/{token}), and the
# connected-accounts OAuth redirect_uri. WRONG VALUE = dead links.
# NOTE: server currently HTTP-only (no TLS on host nginx). Use http:// for now.
# If SSL is added later, change to https:// here AND re-register Azure redirect URI.
APP_BASE_URL=http://hackathon.alignedautomation.com

# Browser-facing origin for OAuth redirect URIs + connect-popup postMessage only.
# Leave unset to inherit APP_BASE_URL. For LOCAL dev set the Vite origin so the
# Zoho/Microsoft callback returns to the dev server (which proxies /api -> :8080):
#   OAUTH_REDIRECT_BASE_URL=http://localhost:3000
# The exact value + /api/integrations/callback/{provider} must be registered in
# the provider's app console.
# OAUTH_REDIRECT_BASE_URL=

# LLM server (Ollama on ml01, reachable over VPN). Set all three explicitly.
AGENT_BASE_URL=http://ml01.alignedautomation.com:11434/v1
ROUTER_BASE_URL=http://ml01.alignedautomation.com:11434/v1
LLM_BASE_URL=http://ml01.alignedautomation.com:11434/v1

# Leave REDIS_URL UNSET — docker-compose injects redis://:${REDIS_PASSWORD}@redis:6379

# ════════════════ Langfuse (LLM tracing / "Open in Langfuse") ════════════════
# In docker these are INJECTED by docker-compose.yml (backend service) to match the
# langfuse-server headless-init keys — you normally DON'T set them here. Set them only
# to point at a different Langfuse. Keys MUST match whatever seeded the Langfuse project.
#   LANGFUSE_HOST        — server-to-server URL the backend pushes traces to.
#                          docker: http://langfuse-server:3000  (injected)
#   LANGFUSE_PUBLIC_KEY  — default pk-lf-centriq-ai   (headless-init seeded)
#   LANGFUSE_SECRET_KEY  — default sk-lf-centriq-ai-2026
#   LANGFUSE_PROJECT_ID  — default centriq-ai; lets the redirect deep-link without an API call
# Re-seed after a key change: prod → reset the langfuse_db_data volume;
#   local infra → drop+recreate ONLY the langfuse DB (keeps the app DB):
#   docker compose -f docker-compose.infra.yml exec db \
#     psql -U postgres -c 'DROP DATABASE langfuse;' -c 'CREATE DATABASE langfuse;'
#   then: docker compose -f docker-compose.infra.yml restart langfuse-server
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PROJECT_ID=

# ════════════════ Models (override only if you know why) ════════════════
# AGENT_MODEL_NAME=gpt-oss:latest
# SERVICE_MODEL_NAME=llama3.1:8b
# ROUTER_MODEL_NAME=llama3.2:3b
# SUMMARIZER_MODEL_NAME=llama3.1:8b
# EMBEDDING_MODEL_NAME=nomic-embed-text

# ════════════════ Microsoft Graph / SharePoint (policy + project sync) ════════════════
# Missing → those features silently disable. Set to enable.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHAREPOINT_SITE_URL=
# SHAREPOINT_POLICY_FOLDERS=ADMIN,IT PMO
# SHAREPOINT_FOLDER_PATH=
# SHAREPOINT_PROJECTS_ROOT=General/Projects
# SHAREPOINT_TEMPLATES_FOLDER=

# ════════════════ Connected accounts (MS365 mail/calendar/Teams) ════════════════
# Only needed if that feature is demoed. Reuses the MSAL app + a Web-platform
# redirect URI = {APP_BASE_URL}/api/integrations/callback/microsoft.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=
# Fernet key (32-byte url-safe base64) for encrypting stored tokens — set if using connected accounts.
TOKEN_ENCRYPTION_KEY=

# ════════════════ Email notifications ════════════════
# All notify emails route here; empty = notifications silently skipped.
NOTIFY_TO_EMAIL=
HELPDESK_EMAIL=shivam.sharma@alignedautomation.com
# Test-mode intercept — ON by default. Every outbound email is redirected to
# NOTIFY_TO_EMAIL regardless of the original recipient (manager, employee, etc.).
# The original To address appears in the subject as [TEST → real@email.com].
# Set EMAIL_TEST_MODE=false only when ready to deliver to real people.
EMAIL_TEST_MODE=true

# ════════════════ Teams notifications ════════════════
# Approve/reject requests are sent to the approver's Teams CHAT (with the action links);
# email is used only as a fallback when the chat can't be delivered. No extra config needed
# for chat — it reuses the connected MS365 delegated token.
#
# Decisions / reminders / info notices are EMAILED and also pinged to the recipient's Teams
# ACTIVITY feed (the bell) via Graph sendActivityNotification. That feed ping stays a no-op
# until ALL of the following are provisioned, then flip the flag to true:
#   1. Add the TeamsActivity.Send scope (already in MICROSOFT_OAUTH_SCOPES default) and have
#      users RECONNECT MS365 so the new consent is captured.
#   2. Publish/install the Centriq Teams app for each recipient (personal scope) with its
#      AAD app id = MICROSOFT_OAUTH_CLIENT_ID (webApplicationInfo.id in the manifest).
#   3. Declare an activityType in the manifest's activities.activityTypes matching
#      TEAMS_ACTIVITY_TYPE below.
#   4. Grant tenant admin consent for TeamsActivity.Send.
TEAMS_ACTIVITY_NOTIFICATIONS_ENABLED=false
TEAMS_ACTIVITY_TYPE=centriqNotification
# SMTP (if used by the email path)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ════════════════ Zoho (demo mode on by default → mock data) ════════════════
ZOHO_DEMO_MODE=true
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=

# ════════════════ Concurrency gate (tune to ml01 capacity) ════════════════
# CHAT_MAX_CONCURRENCY=8
# CHAT_MAX_QUEUE=50
