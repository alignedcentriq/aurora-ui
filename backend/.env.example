# ================================================================
# Centriq AI Backend — Environment Configuration
# Copy this to .env and adjust values for your environment
# ================================================================

# LLM Configuration — Multi-Model Setup
# Router model (fast, lightweight classification)
ROUTER_BASE_URL=http://localhost:11434/v1
ROUTER_MODEL_NAME=llama3.2:3b
ROUTER_API_KEY=ollama

# Agent model (reasoning, tool calling, response generation)
AGENT_BASE_URL=http://localhost:11434/v1
AGENT_MODEL_NAME=llama3.2:3b
AGENT_API_KEY=ollama

# Embedding model (semantic search, RAG)
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL_NAME=nomic-embed-text

# Legacy aliases (backward compat)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=llama3.2:3b
LLM_API_KEY=ollama
LLM_TEMPERATURE=0

# Database Configuration
# Local npm start on Windows/WSL or macOS Docker Desktop: postgresql://postgres:postgres@localhost:5433/centriq
# Inside Docker network/full docker compose:              postgresql://postgres:postgres@db:5432/centriq
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/centriq

# Redis Configuration
# Local npm start uses host port 6380; inside Docker network use redis://redis:6379
REDIS_URL=redis://localhost:6380
USE_MEMORY_SAVER=false

# Langfuse Configuration (tracing)
LANGFUSE_SECRET_KEY=sk-lf-1234567890
LANGFUSE_PUBLIC_KEY=pk-lf-1234567890
LANGFUSE_HOST=http://localhost:3002

# Microsoft Graph API (for SharePoint sync — optional)
GRAPH_TENANT_ID=your_tenant_id_here
GRAPH_CLIENT_ID=your_client_id_here
GRAPH_CLIENT_SECRET=your_client_secret_here
GRAPH_CLIENT_STATE=secretClientState

# Application Defaults
DEFAULT_USER_EMAIL=employee1@centriq.ai
PORT=8080
HOST=0.0.0.0
PYTHONPATH=.

# MinIO Configuration (object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aurora-bucket
MINIO_USE_SSL=false
