# ================================================================
# Centriq AI Backend — Environment Configuration
# Copy this to .env and adjust values for your environment
# ================================================================

# LLM Configuration — Multi-Model Setup
# Use "auto" so Windows uses the shared Aligned server.
# Set an explicit URL if you need to force a specific endpoint.
# Router model (fast, lightweight classification)
ROUTER_BASE_URL=auto
ROUTER_MODEL_NAME=gpt-oss:latest
ROUTER_API_KEY=ollama

# Agent model (reasoning, tool calling, response generation)
AGENT_BASE_URL=auto
AGENT_MODEL_NAME=gpt-oss:latest
AGENT_API_KEY=ollama

# General model (greetings, small talk)
GENERAL_MODEL_NAME=MichelRosselli/apertus:8b-instruct-2509-bf16

# Embedding model (semantic search, RAG)
# EMBEDDING_BASE_URL=auto
# EMBEDDING_MODEL_NAME=gpt-oss:latest

# Legacy aliases (backward compat)
LLM_BASE_URL=auto
LLM_MODEL_NAME=gpt-oss:latest
LLM_API_KEY=ollama
LLM_TEMPERATURE=0

# Database Configuration
# "auto" resolves to 127.0.0.1 for Windows-published WSL Docker ports.
# Override with an explicit URL if needed (e.g. for a remote DB).
DATABASE_URL=auto

# Redis Configuration
# "auto" resolves to 127.0.0.1 for Windows-published WSL Docker ports.
REDIS_URL=auto
USE_MEMORY_SAVER=false

# Langfuse Configuration (tracing)
LANGFUSE_SECRET_KEY=sk-lf-1234567890
LANGFUSE_PUBLIC_KEY=pk-lf-1234567890
LANGFUSE_HOST=http://localhost:3002

# Microsoft Graph API (for SharePoint sync — optional)
GRAPH_TENANT_ID=your_tenant_id_here
GRAPH_CLIENT_ID=your_client_id_here
GRAPH_CLIENT_SECRET=your_client_secret_here
GRAPH_CLIENT_STATE=secretClientState

# Application Defaults
DEFAULT_USER_EMAIL=employee1@centriq.ai
PORT=8080
HOST=0.0.0.0
PYTHONPATH=.

# SMTP / Email — all notifications route to poc@alignedautomation by default
SMTP_HOST=smtp.alignedautomation.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Centriq AI
HELPDESK_EMAIL=poc@alignedautomation
ADMIN_EMAIL=poc@alignedautomation

# MinIO Configuration (object storage)
# "auto" resolves to 127.0.0.1 for Windows-published WSL Docker ports.
MINIO_ENDPOINT=auto
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aurora-bucket
MINIO_USE_SSL=false
